{
  "$defs": {
    "ActionOperationV2": {
      "additionalProperties": false,
      "description": "An explicitly mutating current Operation with a complete safety contract.",
      "properties": {
        "context_bindings": {
          "additionalProperties": {
            "pattern": "^(?:principal_id|tenant_context\\.[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)*)$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Context Bindings",
          "type": "object"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "http": {
          "$ref": "#/$defs/HttpOperationV2"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "kind": {
          "const": "action",
          "title": "Kind",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "schema_version": {
          "const": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "input_schema",
        "output_schema",
        "http",
        "context_bindings",
        "evidence",
        "kind"
      ],
      "title": "ActionOperationV2",
      "type": "object"
    },
    "BodyInjectionTargetV2": {
      "additionalProperties": false,
      "description": "A Runtime-owned value injected at one JSON request-body pointer.",
      "properties": {
        "kind": {
          "const": "body",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "minLength": 1,
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer"
      ],
      "title": "BodyInjectionTargetV2",
      "type": "object"
    },
    "BodyTokenSourceV2": {
      "additionalProperties": false,
      "description": "Capture an optimistic-lock token from a preview response body.",
      "properties": {
        "kind": {
          "const": "body",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "minLength": 1,
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer"
      ],
      "title": "BodyTokenSourceV2",
      "type": "object"
    },
    "ConcurrencyContractV2": {
      "additionalProperties": false,
      "description": "Describe capture and Runtime-owned injection of a concurrency token.",
      "properties": {
        "mode": {
          "enum": [
            "required",
            "not_supported"
          ],
          "title": "Mode",
          "type": "string"
        },
        "precondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeInjectionTargetV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "token": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConcurrencyTokenSourceV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode"
      ],
      "title": "ConcurrencyContractV2",
      "type": "object"
    },
    "ConcurrencyTokenSourceV2": {
      "discriminator": {
        "mapping": {
          "body": "#/$defs/BodyTokenSourceV2",
          "response_header": "#/$defs/ResponseHeaderTokenSourceV2"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ResponseHeaderTokenSourceV2"
        },
        {
          "$ref": "#/$defs/BodyTokenSourceV2"
        }
      ]
    },
    "Effect": {
      "enum": [
        "read",
        "create",
        "update",
        "delete",
        "transition",
        "execute"
      ],
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A digest-bound locator supporting current evidence forms.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "source_file",
                "json_document",
                "openapi",
                "openapi_operation",
                "content",
                "content_summary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "openapi_operation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openapi Operation"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "source_id",
        "digest"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HeaderInjectionTargetV2": {
      "additionalProperties": false,
      "description": "A Runtime-owned value injected into one non-sensitive HTTP header.",
      "properties": {
        "kind": {
          "const": "header",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "HeaderInjectionTargetV2",
      "type": "object"
    },
    "HttpOperationV2": {
      "additionalProperties": false,
      "description": "A bounded current HTTP transport contract with explicit safety semantics.",
      "properties": {
        "max_response_bytes": {
          "maximum": 104857600,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "path_parameters": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Path Parameters",
          "type": "object"
        },
        "query_parameters": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Query Parameters",
          "type": "object"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonRequestV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "safety": {
          "$ref": "#/$defs/OperationSafetyV2"
        },
        "scopes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "success": {
          "$ref": "#/$defs/HttpSuccessV2"
        },
        "timeout_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "unsafe_read_evidence_classification": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsafe Read Evidence Classification"
        }
      },
      "required": [
        "method",
        "path",
        "path_parameters",
        "query_parameters",
        "request",
        "success",
        "scopes",
        "timeout_seconds",
        "max_response_bytes",
        "safety"
      ],
      "title": "HttpOperationV2",
      "type": "object"
    },
    "HttpSuccessV2": {
      "additionalProperties": false,
      "description": "Explicit successful statuses and response-body decoding contract.",
      "properties": {
        "body": {
          "enum": [
            "json",
            "empty",
            "json_or_empty"
          ],
          "title": "Body",
          "type": "string"
        },
        "statuses": {
          "items": {
            "maximum": 299,
            "minimum": 200,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Statuses",
          "type": "array"
        }
      },
      "required": [
        "statuses",
        "body"
      ],
      "title": "HttpSuccessV2",
      "type": "object"
    },
    "IdempotencyContractV2": {
      "additionalProperties": false,
      "description": "Separate source idempotency from Runtime-local duplicate suppression.",
      "properties": {
        "mode": {
          "enum": [
            "unsupported",
            "runtime_deduplicate",
            "source_key"
          ],
          "title": "Mode",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeInjectionTargetV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode"
      ],
      "title": "IdempotencyContractV2",
      "type": "object"
    },
    "JsonRequestV2": {
      "additionalProperties": false,
      "description": "Bounded JSON request-body construction from Operation inputs.",
      "properties": {
        "body_parameters": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Body Parameters",
          "type": "object"
        },
        "kind": {
          "const": "json",
          "title": "Kind",
          "type": "string"
        },
        "max_request_bytes": {
          "maximum": 104857600,
          "minimum": 1,
          "title": "Max Request Bytes",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "body_parameters",
        "max_request_bytes"
      ],
      "title": "JsonRequestV2",
      "type": "object"
    },
    "JsonValue": {},
    "OperationSafetyV2": {
      "additionalProperties": false,
      "description": "Complete, non-defaulted safety contract for one current Operation.",
      "properties": {
        "concurrency": {
          "$ref": "#/$defs/ConcurrencyContractV2"
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "idempotency": {
          "$ref": "#/$defs/IdempotencyContractV2"
        },
        "retry": {
          "$ref": "#/$defs/RetryContractV2"
        },
        "reversibility": {
          "$ref": "#/$defs/Reversibility"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        }
      },
      "required": [
        "effect",
        "risk",
        "reversibility",
        "retry",
        "idempotency",
        "concurrency"
      ],
      "title": "OperationSafetyV2",
      "type": "object"
    },
    "ReadOperationV2": {
      "additionalProperties": false,
      "description": "An explicitly read-only current Operation.",
      "properties": {
        "context_bindings": {
          "additionalProperties": {
            "pattern": "^(?:principal_id|tenant_context\\.[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)*)$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Context Bindings",
          "type": "object"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "http": {
          "$ref": "#/$defs/HttpOperationV2"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "kind": {
          "const": "read",
          "title": "Kind",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "schema_version": {
          "const": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "input_schema",
        "output_schema",
        "http",
        "context_bindings",
        "evidence",
        "kind"
      ],
      "title": "ReadOperationV2",
      "type": "object"
    },
    "ResponseHeaderTokenSourceV2": {
      "additionalProperties": false,
      "description": "Capture an allowlisted response header as an optimistic-lock token.",
      "properties": {
        "kind": {
          "const": "response_header",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "ResponseHeaderTokenSourceV2",
      "type": "object"
    },
    "RetryContractV2": {
      "additionalProperties": false,
      "description": "Declare whether a mutation is ever eligible for a controlled replay.",
      "properties": {
        "mode": {
          "enum": [
            "never",
            "idempotent_only"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "RetryContractV2",
      "type": "object"
    },
    "Reversibility": {
      "enum": [
        "reversible",
        "compensatable",
        "irreversible",
        "unknown"
      ],
      "type": "string"
    },
    "Risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "RuntimeInjectionTargetV2": {
      "discriminator": {
        "mapping": {
          "body": "#/$defs/BodyInjectionTargetV2",
          "header": "#/$defs/HeaderInjectionTargetV2"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HeaderInjectionTargetV2"
        },
        {
          "$ref": "#/$defs/BodyInjectionTargetV2"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "action": "#/$defs/ActionOperationV2",
      "read": "#/$defs/ReadOperationV2"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ReadOperationV2"
    },
    {
      "$ref": "#/$defs/ActionOperationV2"
    }
  ]
}
