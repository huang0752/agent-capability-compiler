{
  "$defs": {
    "AllExpression": {
      "additionalProperties": false,
      "description": "Require every nested safe expression to hold.",
      "properties": {
        "operands": {
          "items": {
            "$ref": "#/$defs/ConditionExpression"
          },
          "minItems": 1,
          "title": "Operands",
          "type": "array"
        },
        "operator": {
          "const": "all",
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "operands"
      ],
      "title": "AllExpression",
      "type": "object"
    },
    "AnyExpression": {
      "additionalProperties": false,
      "description": "Require at least one nested safe expression to hold.",
      "properties": {
        "operands": {
          "items": {
            "$ref": "#/$defs/ConditionExpression"
          },
          "minItems": 1,
          "title": "Operands",
          "type": "array"
        },
        "operator": {
          "const": "any",
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "operands"
      ],
      "title": "AnyExpression",
      "type": "object"
    },
    "ComparisonExpression": {
      "additionalProperties": false,
      "description": "Compare two safe operands without executing source code.",
      "properties": {
        "left": {
          "$ref": "#/$defs/ConditionOperand"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "in"
          ],
          "title": "Operator",
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/ConditionOperand"
        }
      },
      "required": [
        "operator",
        "left",
        "right"
      ],
      "title": "ComparisonExpression",
      "type": "object"
    },
    "ConditionExpression": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllExpression",
          "any": "#/$defs/AnyExpression",
          "eq": "#/$defs/ComparisonExpression",
          "in": "#/$defs/ComparisonExpression",
          "ne": "#/$defs/ComparisonExpression",
          "not": "#/$defs/NotExpression",
          "present": "#/$defs/PresentExpression"
        },
        "propertyName": "operator"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AllExpression"
        },
        {
          "$ref": "#/$defs/AnyExpression"
        },
        {
          "$ref": "#/$defs/NotExpression"
        },
        {
          "$ref": "#/$defs/ComparisonExpression"
        },
        {
          "$ref": "#/$defs/PresentExpression"
        }
      ]
    },
    "ConditionOperand": {
      "discriminator": {
        "mapping": {
          "literal": "#/$defs/LiteralOperand",
          "reference": "#/$defs/ReferenceOperand"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReferenceOperand"
        },
        {
          "$ref": "#/$defs/LiteralOperand"
        }
      ]
    },
    "InputMapping": {
      "additionalProperties": false,
      "description": "A bounded declarative value mapping recorded by discovery.",
      "properties": {
        "kind": {
          "enum": [
            "identity",
            "date",
            "datetime",
            "enum",
            "identifier",
            "locale",
            "null",
            "number",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mapping": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Mapping",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "InputMapping",
      "type": "object"
    },
    "JsonValue": {},
    "LiteralOperand": {
      "additionalProperties": false,
      "description": "Use one inert JSON-compatible literal in a condition.",
      "properties": {
        "kind": {
          "const": "literal",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LiteralOperand",
      "type": "object"
    },
    "NotExpression": {
      "additionalProperties": false,
      "description": "Negate one nested safe expression.",
      "properties": {
        "operand": {
          "$ref": "#/$defs/ConditionExpression"
        },
        "operator": {
          "const": "not",
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "operand"
      ],
      "title": "NotExpression",
      "type": "object"
    },
    "PresentExpression": {
      "additionalProperties": false,
      "description": "Test whether one safe operand is present.",
      "properties": {
        "operand": {
          "$ref": "#/$defs/ConditionOperand"
        },
        "operator": {
          "const": "present",
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "operand"
      ],
      "title": "PresentExpression",
      "type": "object"
    },
    "ReferenceOperand": {
      "additionalProperties": false,
      "description": "Read one declared value by an absolute JSON Pointer.",
      "properties": {
        "kind": {
          "const": "reference",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer"
      ],
      "title": "ReferenceOperand",
      "type": "object"
    },
    "UsageActionLifecycle": {
      "additionalProperties": false,
      "description": "References for the runtime-owned prepare, approval, commit, and status phases.",
      "properties": {
        "action_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "approval": {
          "enum": [
            "never",
            "always",
            "conditional"
          ],
          "title": "Approval",
          "type": "string"
        },
        "approval_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionExpression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_handle_binding_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Handle Binding Id"
        },
        "approve_action_handle_binding_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approve Action Handle Binding Id"
        },
        "approve_step_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approve Step Id"
        },
        "commit_action_handle_binding_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Commit Action Handle Binding Id",
          "type": "string"
        },
        "commit_step_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Commit Step Id",
          "type": "string"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "outcome_unknown_behavior": {
          "const": "query_status",
          "title": "Outcome Unknown Behavior",
          "type": "string"
        },
        "prepare_step_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Prepare Step Id",
          "type": "string"
        },
        "status_action_handle_binding_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Status Action Handle Binding Id",
          "type": "string"
        },
        "status_step_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Status Step Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action_id",
        "prepare_step_id",
        "commit_action_handle_binding_id",
        "status_action_handle_binding_id",
        "approval",
        "commit_step_id",
        "status_step_id",
        "outcome_unknown_behavior"
      ],
      "title": "UsageActionLifecycle",
      "type": "object"
    },
    "UsageBusinessGoal": {
      "additionalProperties": false,
      "description": "Stable business goal adopted by one domain contract.",
      "properties": {
        "description": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_claim_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Claim Ids",
          "type": "array"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "evidence_claim_ids"
      ],
      "title": "UsageBusinessGoal",
      "type": "object"
    },
    "UsageConditionRef": {
      "additionalProperties": false,
      "description": "Evidence-bound inert condition scoped to a route or step.",
      "properties": {
        "evidence_claim_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Claim Ids",
          "type": "array"
        },
        "expression": {
          "$ref": "#/$defs/ConditionExpression"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "visible",
            "enabled",
            "required",
            "reset",
            "execute"
          ],
          "title": "Kind",
          "type": "string"
        },
        "route_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Route Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "route",
            "step"
          ],
          "title": "Scope",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step Id"
        },
        "target_pointer": {
          "title": "Target Pointer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "scope",
        "route_id",
        "step_id",
        "target_pointer",
        "expression",
        "evidence_claim_ids"
      ],
      "title": "UsageConditionRef",
      "type": "object"
    },
    "UsageDefaultRef": {
      "additionalProperties": false,
      "description": "Evidence-bound default applied to one declared tool input.",
      "properties": {
        "capability_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "evidence_claim_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Claim Ids",
          "type": "array"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "precedence": {
          "exclusiveMinimum": 0,
          "title": "Precedence",
          "type": "integer"
        },
        "reference_binding_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Binding Id"
        },
        "source": {
          "enum": [
            "literal",
            "binding",
            "source_default"
          ],
          "title": "Source",
          "type": "string"
        },
        "step_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "submission": {
          "enum": [
            "always",
            "when_missing",
            "omit_when_absent"
          ],
          "title": "Submission",
          "type": "string"
        },
        "target_pointer": {
          "title": "Target Pointer",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "capability_id",
        "step_id",
        "evidence_claim_ids",
        "target_pointer",
        "source",
        "precedence",
        "submission"
      ],
      "title": "UsageDefaultRef",
      "type": "object"
    },
    "UsageErrorBranch": {
      "additionalProperties": false,
      "description": "Deterministic behavior for one or more normalized failure outcomes.",
      "properties": {
        "behavior": {
          "enum": [
            "stop",
            "return_empty",
            "retry",
            "query_status"
          ],
          "title": "Behavior",
          "type": "string"
        },
        "description": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_claim_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Claim Ids",
          "type": "array"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Outcomes",
          "type": "array"
        },
        "retry_policy": {
          "enum": [
            "never",
            "safe_read",
            "idempotent",
            "status_only"
          ],
