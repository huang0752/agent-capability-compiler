          "type": "string"
        },
        "step_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "outcomes",
        "behavior",
        "description",
        "step_ids",
        "retry_policy",
        "evidence_claim_ids"
      ],
      "title": "UsageErrorBranch",
      "type": "object"
    },
    "UsageEvidenceClaim": {
      "additionalProperties": false,
      "description": "One bounded statement backed by independently loaded Evidence identities.",
      "properties": {
        "authority": {
          "enum": [
            "contract",
            "implementation",
            "test",
            "observation"
          ],
          "title": "Authority",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/UsageEvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source_layer": {
          "enum": [
            "client",
            "service",
            "test",
            "mcp",
            "runtime_observation"
          ],
          "title": "Source Layer",
          "type": "string"
        },
        "statement": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/UsageEvidenceTarget"
