      },
      "required": [
        "id",
        "statement",
        "target",
        "authority",
        "source_layer",
        "evidence_refs"
      ],
      "title": "UsageEvidenceClaim",
      "type": "object"
    },
    "UsageEvidenceRef": {
      "additionalProperties": false,
      "description": "Immutable identity of one independently loaded Evidence artifact.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "source_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "digest"
      ],
      "title": "UsageEvidenceRef",
      "type": "object"
    },
    "UsageEvidenceTarget": {
      "additionalProperties": false,
      "description": "Typed contract object and field targeted by one evidence claim.",
      "properties": {
        "field_pointer": {
          "title": "Field Pointer",
