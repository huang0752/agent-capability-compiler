          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "target_id",
        "field_pointer"
      ],
      "title": "UsageEvidenceTarget",
      "type": "object"
    },
    "UsageOptionItem": {
