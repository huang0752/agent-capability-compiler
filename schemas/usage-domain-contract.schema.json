      "properties": {
        "capability_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "evidence_claim_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
