{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deterministic route scenario in the exact domain test denominator.",
  "properties": {
    "domain_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Domain Id",
      "type": "string"
    },
    "expected_outcomes": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Outcomes",
      "type": "array"
    },
    "kind": {
      "enum": [
        "happy_path",
        "empty_result",
        "missing_input",
        "related_not_found",
        "unauthorized",
        "forbidden",
        "not_found",
        "timeout",
        "source_error",
        "stale_input",
        "tool_selection",
        "prohibited_behavior",
        "action_lifecycle",
        "conflict",
        "outcome_unknown",
        "digest_mismatch"
      ],
      "title": "Kind",
      "type": "string"
    },
    "prohibited_behaviors": {
      "items": {
        "maxLength": 16384,
        "minLength": 1,
        "type": "string"
      },
      "title": "Prohibited Behaviors",
      "type": "array"
    },
    "public_input_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Public Input Ids",
      "type": "array"
    },
    "route_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Route Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 16384,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "domain_id",
    "route_id",
    "title",
    "kind",
    "public_input_ids",
    "expected_outcomes",
    "prohibited_behaviors"
  ],
  "title": "UsageScenario",
  "type": "object"
}
