{
  "$defs": {
    "ChangedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "enum": [
            "added",
            "modified",
            "removed"
          ],
          "title": "Change",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "new_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "New Digest"
        },
        "old_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Old Digest"
        }
      },
      "required": [
        "evidence_ref",
        "change",
        "old_digest",
        "new_digest"
      ],
      "title": "ChangedEvidenceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded, typed input produced by an external deterministic change locator.",
  "properties": {
    "changed_evidence": {
      "items": {
        "$ref": "#/$defs/ChangedEvidenceRef"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Changed Evidence",
      "type": "array"
    },
    "observed_at": {
      "maxLength": 40,
      "minLength": 20,
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "observed_at",
    "changed_evidence"
  ],
  "title": "EvidenceChangeSet",
  "type": "object"
}
