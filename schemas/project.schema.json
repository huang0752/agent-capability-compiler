{
  "$defs": {
    "BearerSecretAuthConfig": {
      "additionalProperties": false,
      "description": "Resolve one fixed bearer token from the deployment environment.",
      "properties": {
        "kind": {
          "const": "bearer_secret",
          "title": "Kind",
          "type": "string"
        },
        "token_ref": {
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Token Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "token_ref"
      ],
      "title": "BearerSecretAuthConfig",
      "type": "object"
    },
    "EnvironmentSecretCredentials": {
      "additionalProperties": false,
      "description": "Resolve a renewable username/password pair from environment secrets.",
      "properties": {
        "identity_ref": {
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Identity Ref",
          "type": "string"
        },
        "kind": {
          "const": "environment_secret",
          "title": "Kind",
          "type": "string"
        },
        "password_ref": {
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Password Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identity_ref",
        "password_ref"
      ],
      "title": "EnvironmentSecretCredentials",
      "type": "object"
    },
    "GatewaySessionCredentials": {
      "additionalProperties": false,
      "description": "Accept a one-shot username/password pair from a trusted Gateway session.",
      "properties": {
        "kind": {
          "const": "gateway_session",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "GatewaySessionCredentials",
      "type": "object"
    },
    "JsonPointerApplicationSuccessConfig": {
      "additionalProperties": false,
      "description": "Declare exact application-level success for a JSON envelope.",
      "properties": {
        "allowed_values": {
          "items": {
            "$ref": "#/$defs/JsonScalar"
          },
          "minItems": 1,
          "title": "Allowed Values",
          "type": "array"
        },
        "kind": {
          "const": "json_pointer",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "minLength": 1,
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer",
        "allowed_values"
      ],
      "title": "JsonPointerApplicationSuccessConfig",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "LoginRequestConfig": {
      "additionalProperties": false,
      "description": "Public, non-secret scalar fields added to a password login JSON object.",
      "properties": {
        "static_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "maxProperties": 32,
          "title": "Static Fields",
          "type": "object"
        }
      },
      "title": "LoginRequestConfig",
      "type": "object"
    },
    "NoAuthConfig": {
      "additionalProperties": false,
      "description": "Explicitly declare that the provider requires no authentication.",
      "properties": {
        "kind": {
          "const": "none",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NoAuthConfig",
      "type": "object"
    },
    "PasswordBearerAuthConfig": {
      "additionalProperties": false,
      "description": "Exchange a bounded credential source for a bearer token.",
      "properties": {
        "credentials": {
          "$ref": "#/$defs/PasswordBearerCredentials"
        },
        "expires_in_pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires In Pointer"
        },
        "identity_field": {
          "minLength": 1,
          "title": "Identity Field",
          "type": "string"
        },
        "kind": {
          "const": "password_bearer",
          "title": "Kind",
          "type": "string"
        },
        "login_path": {
          "minLength": 1,
          "title": "Login Path",
          "type": "string"
        },
        "login_request": {
          "$ref": "#/$defs/LoginRequestConfig"
        },
        "max_response_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "password_field": {
          "minLength": 1,
          "title": "Password Field",
          "type": "string"
        },
        "principal_pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Principal Pointer"
        },
        "retry_on_unauthorized": {
          "default": false,
          "title": "Retry On Unauthorized",
          "type": "boolean"
        },
        "scope_discovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeDiscoveryConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope_mapping": {
          "additionalProperties": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Scope Mapping",
          "type": "object"
        },
        "scopes_format": {
          "default": "json_array",
          "enum": [
            "json_array",
            "space_delimited"
          ],
          "title": "Scopes Format",
          "type": "string"
        },
        "scopes_pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scopes Pointer"
        },
        "tenant_pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Pointer"
        },
        "timeout_seconds": {
          "default": 10,
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "token_pointer": {
          "minLength": 1,
          "title": "Token Pointer",
          "type": "string"
        },
        "token_type_pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Type Pointer"
        }
      },
      "required": [
        "kind",
        "credentials",
        "login_path",
        "identity_field",
        "password_field",
        "token_pointer"
      ],
      "title": "PasswordBearerAuthConfig",
      "type": "object"
    },
    "PasswordBearerCredentials": {
      "discriminator": {
        "mapping": {
          "environment_secret": "#/$defs/EnvironmentSecretCredentials",
          "gateway_session": "#/$defs/GatewaySessionCredentials"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/EnvironmentSecretCredentials"
        },
        {
          "$ref": "#/$defs/GatewaySessionCredentials"
        }
      ]
    },
    "ProjectIdentity": {
      "additionalProperties": false,
      "description": "Stable identity of an ACC project.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ProjectIdentity",
      "type": "object"
    },
    "ProviderAuthConfig": {
      "discriminator": {
        "mapping": {
          "bearer_secret": "#/$defs/BearerSecretAuthConfig",
          "none": "#/$defs/NoAuthConfig",
          "password_bearer": "#/$defs/PasswordBearerAuthConfig"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoAuthConfig"
        },
        {
          "$ref": "#/$defs/BearerSecretAuthConfig"
        },
        {
          "$ref": "#/$defs/PasswordBearerAuthConfig"
        }
      ]
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "description": "Reference to the target REST provider without embedding its URL.",
      "properties": {
        "application_success": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonPointerApplicationSuccessConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderAuthConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "base_url_ref": {
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Base Url Ref",
          "type": "string"
        },
        "context_binding_allowlist": {
          "items": {
            "pattern": "^tenant_context\\.[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)*$",
            "type": "string"
          },
          "title": "Context Binding Allowlist",
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "const": "http",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "base_url_ref"
      ],
      "title": "ProviderConfig",
      "type": "object"
    },
    "QualityProfileV2": {
      "additionalProperties": false,
      "description": "Select the compile-time quality gate for a current project.",
      "properties": {
        "profile": {
          "enum": [
            "standard",
            "release"
          ],
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile"
      ],
      "title": "QualityProfileV2",
      "type": "object"
    },
    "RuntimeConfig": {
      "additionalProperties": false,
      "description": "Runtime transports emitted by the first ACC release.",
      "properties": {
        "transport": {
          "items": {
            "enum": [
              "stdio",
              "streamable_http"
            ],
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Transport",
          "type": "array"
        }
      },
      "required": [
        "transport"
      ],
      "title": "RuntimeConfig",
      "type": "object"
    },
    "ScopeDiscoveryConfig": {
      "additionalProperties": false,
      "description": "Discover source-authorized scopes with one bounded bearer GET.",
      "properties": {
        "application_success": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonPointerApplicationSuccessConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_response_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "scopes_format": {
          "default": "json_array",
          "enum": [
            "json_array",
            "space_delimited"
          ],
          "title": "Scopes Format",
          "type": "string"
        },
        "scopes_pointer": {
          "minLength": 1,
          "title": "Scopes Pointer",
          "type": "string"
        },
        "static_query_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "maxProperties": 16,
          "title": "Static Query Fields",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 5,
          "maximum": 30,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "scopes_pointer"
      ],
      "title": "ScopeDiscoveryConfig",
      "type": "object"
    },
    "SourceWorkspace": {
      "additionalProperties": false,
      "description": "Source system location, which ACC always treats as read-only.",
      "properties": {
        "mode": {
          "const": "read_only",
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "mode"
      ],
      "title": "SourceWorkspace",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The sole current project contract with explicit quality controls.",
  "properties": {
    "project": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "provider": {
      "$ref": "#/$defs/ProviderConfig"
    },
    "quality": {
      "$ref": "#/$defs/QualityProfileV2"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_workspace": {
      "$ref": "#/$defs/SourceWorkspace"
    }
  },
  "required": [
    "schema_version",
    "project",
    "source_workspace",
    "runtime",
    "provider",
    "quality"
  ],
  "title": "Project",
  "type": "object"
}
