{
  "$defs": {
    "ActionCapabilityV2": {
      "additionalProperties": false,
      "description": "Separate preview and commit workflows for a business Action.\n\nThe compiler later proves that preview is read-only, commit contains the\npermitted mutation topology, and references such as ``$.prepared`` cannot\nbe supplied by an Agent.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionContractV2"
        },
        "commit_workflow": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "minItems": 1,
          "title": "Commit Workflow",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evals": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evals",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "kind": {
          "const": "action",
          "title": "Kind",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "policy": {
          "minLength": 1,
          "title": "Policy",
          "type": "string"
        },
        "preview_workflow": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "minItems": 1,
          "title": "Preview Workflow",
          "type": "array"
        },
        "schema_version": {
          "const": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "description",
        "input_schema",
        "output_schema",
        "policy",
        "evals",
        "kind",
        "action",
        "preview_workflow",
        "commit_workflow"
      ],
      "title": "ActionCapabilityV2",
      "type": "object"
    },
    "ActionContractV2": {
      "additionalProperties": false,
      "description": "Lifecycle controls that every Action Capability must state explicitly.",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalContractV2"
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "expires_in_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Expires In Seconds",
          "type": "integer"
        },
        "local_development_state_guard": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalDevelopmentStateGuardV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "execution_mode",
        "approval",
        "expires_in_seconds"
      ],
      "title": "ActionContractV2",
      "type": "object"
    },
    "ApprovalContractV2": {
      "additionalProperties": false,
      "description": "Declare whether a trusted approval grant is required before commit.",
      "properties": {
        "mode": {
          "enum": [
            "required",
            "not_required"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ApprovalContractV2",
      "type": "object"
    },
    "AssertAction": {
      "additionalProperties": false,
      "description": "Assert a declarative condition without executing code.",
      "properties": {
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "condition",
        "message"
      ],
      "title": "AssertAction",
      "type": "object"
    },
    "AssertStep": {
      "additionalProperties": false,
      "properties": {
        "assert": {
          "$ref": "#/$defs/AssertAction"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "assert"
      ],
      "title": "AssertStep",
      "type": "object"
    },
    "BranchAction": {
      "additionalProperties": false,
      "description": "Choose between two statically declared workflow branches.",
      "properties": {
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "else": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "minItems": 1,
          "title": "Else",
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "minItems": 1,
          "title": "Then",
          "type": "array"
        }
      },
      "required": [
        "condition",
        "then",
        "else"
      ],
      "title": "BranchAction",
      "type": "object"
    },
    "BranchStep": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "$ref": "#/$defs/BranchAction"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "branch"
      ],
      "title": "BranchStep",
      "type": "object"
    },
    "CallAction": {
      "additionalProperties": false,
      "description": "Invoke a declared operation using declarative arguments.",
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "arguments"
      ],
      "title": "CallAction",
      "type": "object"
    },
    "CallStep": {
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/CallAction"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "call"
      ],
      "title": "CallStep",
      "type": "object"
    },
    "EmitAction": {
      "additionalProperties": false,
      "description": "Emit a deterministic JSON-compatible value.",
      "properties": {
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "value"
      ],
      "title": "EmitAction",
      "type": "object"
    },
    "EmitStep": {
      "additionalProperties": false,
      "properties": {
        "emit": {
          "$ref": "#/$defs/EmitAction"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "emit"
      ],
      "title": "EmitStep",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "single",
        "source_transaction",
        "saga"
      ],
      "type": "string"
    },
    "FilterAction": {
      "additionalProperties": false,
      "description": "Apply a bounded declarative predicate to a collection.",
      "properties": {
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/JsonValue"
        },
        "max_items": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "condition",
        "max_items"
      ],
      "title": "FilterAction",
      "type": "object"
    },
    "FilterStep": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "$ref": "#/$defs/FilterAction"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "filter"
      ],
      "title": "FilterStep",
      "type": "object"
    },
    "ForeachAction": {
      "additionalProperties": false,
      "description": "Run a workflow for at most one hundred input items.",
      "properties": {
        "item_name": {
          "minLength": 1,
          "title": "Item Name",
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/JsonValue"
        },
        "max_items": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "workflow": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "minItems": 1,
          "title": "Workflow",
          "type": "array"
        }
      },
      "required": [
        "items",
        "item_name",
        "max_items",
        "workflow"
      ],
      "title": "ForeachAction",
      "type": "object"
    },
    "ForeachStep": {
      "additionalProperties": false,
      "properties": {
        "foreach": {
          "$ref": "#/$defs/ForeachAction"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "required": [
        "foreach"
      ],
      "title": "ForeachStep",
      "type": "object"
    },
    "JsonValue": {},
    "LocalDevelopmentStateGuardV2": {
      "additionalProperties": false,
      "description": "Runtime-only state guard for an explicitly local development sandbox.\n\nThis declaration does not assert source-system atomicity. It only permits\ncooperating ACC runtime calls to lock, re-read, and deduplicate locally.",
      "properties": {
        "allowed_values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "minItems": 1,
          "title": "Allowed Values",
          "type": "array"
        },
        "mode": {
          "const": "local_development_runtime_guard",
          "title": "Mode",
          "type": "string"
        },
        "read_operation_id": {
          "minLength": 1,
          "title": "Read Operation Id",
          "type": "string"
        },
        "resource_key_pointer": {
          "minLength": 1,
          "title": "Resource Key Pointer",
          "type": "string"
        },
        "state_pointer": {
          "minLength": 1,
          "title": "State Pointer",
          "type": "string"
        },
        "terminal_values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "minItems": 1,
          "title": "Terminal Values",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "resource_key_pointer",
        "read_operation_id",
        "state_pointer",
        "allowed_values",
        "terminal_values"
      ],
      "title": "LocalDevelopmentStateGuardV2",
      "type": "object"
    },
    "MapAction": {
      "additionalProperties": false,
      "description": "Apply a bounded declarative mapping expression to a collection.",
      "properties": {
        "expression": {
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/JsonValue"
        },
        "max_items": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "expression",
        "max_items"
      ],
      "title": "MapAction",
      "type": "object"
    },
    "MapStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "map": {
          "$ref": "#/$defs/MapAction"
        }
      },
      "required": [
        "map"
      ],
      "title": "MapStep",
      "type": "object"
    },
    "ParallelStep": {
      "additionalProperties": false,
      "description": "Run one to eight statically declared workflow steps concurrently.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "parallel": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Parallel",
          "type": "array"
        }
      },
      "required": [
        "parallel"
      ],
      "title": "ParallelStep",
      "type": "object"
    },
    "PickAction": {
      "additionalProperties": false,
      "description": "Select an allow-list of fields from a value.",
      "properties": {
        "fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "value",
        "fields"
      ],
      "title": "PickAction",
      "type": "object"
    },
    "PickStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "pick": {
          "$ref": "#/$defs/PickAction"
        }
      },
      "required": [
        "pick"
      ],
      "title": "PickStep",
      "type": "object"
    },
    "ReadCapabilityV2": {
      "additionalProperties": false,
      "description": "One deterministic read workflow.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evals": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evals",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Input Schema",
          "type": "object"
        },
        "kind": {
          "const": "read",
          "title": "Kind",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "policy": {
          "minLength": 1,
          "title": "Policy",
          "type": "string"
        },
        "schema_version": {
          "const": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "workflow": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "minItems": 1,
          "title": "Workflow",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "description",
        "input_schema",
        "output_schema",
        "policy",
        "evals",
        "kind",
        "workflow"
      ],
      "title": "ReadCapabilityV2",
      "type": "object"
    },
    "RedactAction": {
      "additionalProperties": false,
      "description": "Remove fields from a workflow value.",
      "properties": {
        "fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "value",
        "fields"
      ],
      "title": "RedactAction",
      "type": "object"
    },
    "RedactStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "redact": {
          "$ref": "#/$defs/RedactAction"
        }
      },
      "required": [
        "redact"
      ],
      "title": "RedactStep",
      "type": "object"
    },
    "WorkflowStep": {
      "anyOf": [
        {
          "$ref": "#/$defs/CallStep"
        },
        {
          "$ref": "#/$defs/PickStep"
        },
        {
          "$ref": "#/$defs/MapStep"
        },
        {
          "$ref": "#/$defs/FilterStep"
        },
        {
          "$ref": "#/$defs/AssertStep"
        },
        {
          "$ref": "#/$defs/RedactStep"
        },
        {
          "$ref": "#/$defs/BranchStep"
        },
        {
          "$ref": "#/$defs/ParallelStep"
        },
        {
          "$ref": "#/$defs/ForeachStep"
        },
        {
          "$ref": "#/$defs/EmitStep"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "action": "#/$defs/ActionCapabilityV2",
      "read": "#/$defs/ReadCapabilityV2"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ReadCapabilityV2"
    },
    {
      "$ref": "#/$defs/ActionCapabilityV2"
    }
  ]
}
