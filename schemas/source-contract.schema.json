{
  "$defs": {
    "ActionSemantics": {
      "additionalProperties": false,
      "description": "Evidence-backed source semantics for one mutating Operation.",
      "properties": {
        "authority": {
          "enum": [
            "contract",
            "implementation",
            "test"
          ],
          "title": "Authority",
          "type": "string"
        },
        "concurrency": {
          "$ref": "#/$defs/ConcurrencyContractV2"
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "idempotency": {
          "$ref": "#/$defs/IdempotencyContractV2"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "outcome_resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutcomeResolutionContractV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/ActionSemanticsProvenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "retry": {
          "$ref": "#/$defs/RetryContractV2"
        },
        "reversibility": {
          "$ref": "#/$defs/Reversibility"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        }
      },
      "required": [
        "method",
        "effect",
        "risk",
        "reversibility",
        "retry",
        "idempotency",
        "concurrency",
        "evidence",
        "authority"
      ],
      "title": "ActionSemantics",
      "type": "object"
    },
    "ActionSemanticsProvenance": {
      "additionalProperties": false,
      "description": "Bind one Action safety field to trusted source Evidence.",
      "properties": {
        "authority": {
          "enum": [
            "contract",
            "implementation",
            "test"
          ],
          "title": "Authority",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "evidence_pointer": {
          "title": "Evidence Pointer",
          "type": "string"
        },
        "field": {
          "enum": [
            "conflict_control",
            "effect",
            "idempotency",
            "outcome_resolution",
            "reversibility",
            "retry",
            "risk"
          ],
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "evidence",
        "evidence_pointer",
        "authority"
      ],
      "title": "ActionSemanticsProvenance",
      "type": "object"
    },
    "BodyInjectionTargetV2": {
      "additionalProperties": false,
      "description": "A Runtime-owned value injected at one JSON request-body pointer.",
      "properties": {
        "kind": {
          "const": "body",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "minLength": 1,
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer"
      ],
      "title": "BodyInjectionTargetV2",
      "type": "object"
    },
    "BodyTokenSourceV2": {
      "additionalProperties": false,
      "description": "Capture an optimistic-lock token from a preview response body.",
      "properties": {
        "kind": {
          "const": "body",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "minLength": 1,
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer"
      ],
      "title": "BodyTokenSourceV2",
      "type": "object"
    },
    "ConcurrencyContractV2": {
      "discriminator": {
        "mapping": {
          "not_supported": "#/$defs/UnsupportedConcurrencyV2",
          "required": "#/$defs/OptimisticTokenConcurrencyV2",
          "server_serialized_state_predicate": "#/$defs/ServerSerializedStatePredicateV2"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OptimisticTokenConcurrencyV2"
        },
        {
          "$ref": "#/$defs/ServerSerializedStatePredicateV2"
        },
        {
          "$ref": "#/$defs/UnsupportedConcurrencyV2"
        }
      ]
    },
    "ConcurrencyTokenSourceV2": {
      "discriminator": {
        "mapping": {
          "body": "#/$defs/BodyTokenSourceV2",
          "response_header": "#/$defs/ResponseHeaderTokenSourceV2"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ResponseHeaderTokenSourceV2"
        },
        {
          "$ref": "#/$defs/BodyTokenSourceV2"
        }
      ]
    },
    "Effect": {
      "enum": [
        "read",
        "create",
        "update",
        "delete",
        "transition",
        "execute"
      ],
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A digest-bound locator supporting current evidence forms.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "source_file",
                "json_document",
                "openapi",
                "openapi_operation",
                "content",
                "content_summary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "openapi_operation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openapi Operation"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "source_id",
        "digest"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HeaderInjectionTargetV2": {
      "additionalProperties": false,
      "description": "A Runtime-owned value injected into one non-sensitive HTTP header.",
      "properties": {
        "kind": {
          "const": "header",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "HeaderInjectionTargetV2",
      "type": "object"
    },
    "IdempotencyContractV2": {
      "discriminator": {
        "mapping": {
          "runtime_deduplicate": "#/$defs/UnsupportedIdempotencyV2",
          "source_key": "#/$defs/SourceKeyIdempotencyV2",
          "state_idempotent": "#/$defs/StateIdempotencyV2",
          "unsupported": "#/$defs/UnsupportedIdempotencyV2"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UnsupportedIdempotencyV2"
        },
        {
          "$ref": "#/$defs/SourceKeyIdempotencyV2"
        },
        {
          "$ref": "#/$defs/StateIdempotencyV2"
        }
      ]
    },
    "JsonValue": {},
    "OptimisticTokenConcurrencyV2": {
      "additionalProperties": false,
      "description": "Capture and inject an optimistic-lock token using the legacy wire mode.",
      "properties": {
        "mode": {
          "const": "required",
          "title": "Mode",
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/RuntimeInjectionTargetV2"
        },
        "token": {
          "$ref": "#/$defs/ConcurrencyTokenSourceV2"
        }
      },
      "required": [
        "mode",
        "token",
        "precondition"
      ],
      "title": "OptimisticTokenConcurrencyV2",
      "type": "object"
    },
    "OutcomeResolutionContractV2": {
      "discriminator": {
        "mapping": {
          "outcome_unknown": "#/$defs/UnknownOutcomeResolutionV2",
          "status_query": "#/$defs/StatusQueryOutcomeResolutionV2",
          "synchronous_result": "#/$defs/SynchronousOutcomeResolutionV2"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SynchronousOutcomeResolutionV2"
        },
        {
          "$ref": "#/$defs/StatusQueryOutcomeResolutionV2"
        },
        {
          "$ref": "#/$defs/UnknownOutcomeResolutionV2"
        }
      ]
    },
    "ResponseHeaderTokenSourceV2": {
      "additionalProperties": false,
      "description": "Capture an allowlisted response header as an optimistic-lock token.",
      "properties": {
        "kind": {
          "const": "response_header",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "ResponseHeaderTokenSourceV2",
      "type": "object"
    },
    "RetryContractV2": {
      "additionalProperties": false,
      "description": "Declare whether a mutation is ever eligible for a controlled replay.",
      "properties": {
        "mode": {
          "enum": [
            "never",
            "idempotent_only"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "RetryContractV2",
      "type": "object"
    },
    "Reversibility": {
      "enum": [
        "reversible",
        "compensatable",
        "irreversible",
        "unknown"
      ],
      "type": "string"
    },
    "Risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "RuntimeInjectionTargetV2": {
      "discriminator": {
        "mapping": {
          "body": "#/$defs/BodyInjectionTargetV2",
          "header": "#/$defs/HeaderInjectionTargetV2"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HeaderInjectionTargetV2"
        },
        {
          "$ref": "#/$defs/BodyInjectionTargetV2"
        }
      ]
    },
    "SchemaProvenance": {
      "additionalProperties": false,
      "description": "Bind one source-schema claim to immutable evidence.",
      "properties": {
        "authority": {
          "enum": [
            "contract",
            "implementation",
            "test",
            "observation"
          ],
          "title": "Authority",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "evidence_schema_pointer": {
          "title": "Evidence Schema Pointer",
          "type": "string"
        },
        "target_pointer": {
          "title": "Target Pointer",
          "type": "string"
        }
      },
      "required": [
        "target_pointer",
        "evidence",
        "evidence_schema_pointer",
        "authority"
      ],
      "title": "SchemaProvenance",
      "type": "object"
    },
    "ServerSerializedStatePredicateV2": {
      "additionalProperties": false,
      "description": "Rely on an evidenced source-serialized transition from allowed state.",
      "properties": {
        "allowed_values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "minItems": 1,
          "title": "Allowed Values",
          "type": "array"
        },
        "mode": {
          "const": "server_serialized_state_predicate",
          "title": "Mode",
          "type": "string"
        },
        "read_operation_id": {
          "minLength": 1,
          "title": "Read Operation Id",
          "type": "string"
        },
        "state_pointer": {
          "minLength": 1,
          "title": "State Pointer",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "read_operation_id",
        "state_pointer",
        "allowed_values"
      ],
      "title": "ServerSerializedStatePredicateV2",
      "type": "object"
    },
    "SourceKeyIdempotencyV2": {
      "additionalProperties": false,
      "description": "Inject a Runtime-owned source idempotency key.",
      "properties": {
        "mode": {
          "const": "source_key",
          "title": "Mode",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/RuntimeInjectionTargetV2"
        }
      },
      "required": [
        "mode",
        "target"
      ],
      "title": "SourceKeyIdempotencyV2",
      "type": "object"
    },
    "StateIdempotencyV2": {
      "additionalProperties": false,
      "description": "Treat already-terminal source state as an idempotent outcome.",
      "properties": {
        "mode": {
          "const": "state_idempotent",
          "title": "Mode",
          "type": "string"
        },
        "state_pointer": {
          "minLength": 1,
          "title": "State Pointer",
          "type": "string"
        },
        "terminal_values": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "minItems": 1,
          "title": "Terminal Values",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "state_pointer",
        "terminal_values"
      ],
      "title": "StateIdempotencyV2",
      "type": "object"
    },
    "StatusQueryOutcomeResolutionV2": {
      "additionalProperties": false,
      "description": "Resolve a mutation outcome through one declared read Operation.",
      "properties": {
        "mode": {
          "const": "status_query",
          "title": "Mode",
          "type": "string"
        },
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "request_bindings": {
          "items": {
            "$ref": "#/$defs/StatusQueryRequestBindingV2"
          },
          "title": "Request Bindings",
          "type": "array"
        },
        "success_pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Pointer"
        },
        "success_values": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Values"
        }
      },
      "required": [
        "mode",
        "operation_id"
      ],
      "title": "StatusQueryOutcomeResolutionV2",
      "type": "object"
    },
    "StatusQueryRequestBindingV2": {
      "additionalProperties": false,
      "description": "Map one sealed Action value into a declared status-query input.",
      "properties": {
        "source": {
          "enum": [
            "capability_input",
            "prepared_preview",
            "runtime_idempotency_key"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_pointer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Pointer"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "source"
      ],
      "title": "StatusQueryRequestBindingV2",
      "type": "object"
    },
    "SynchronousOutcomeResolutionV2": {
      "additionalProperties": false,
      "description": "Treat the definitive mutation response as the source outcome.",
      "properties": {
        "mode": {
          "const": "synchronous_result",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "SynchronousOutcomeResolutionV2",
      "type": "object"
    },
    "UnknownOutcomeResolutionV2": {
      "additionalProperties": false,
      "description": "Declare that ambiguous mutation outcomes cannot be resolved automatically.",
      "properties": {
        "mode": {
          "const": "outcome_unknown",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "UnknownOutcomeResolutionV2",
      "type": "object"
    },
    "UnsupportedConcurrencyV2": {
      "additionalProperties": false,
      "description": "Declare that no accepted conflict-control strategy is available.",
      "properties": {
        "mode": {
          "const": "not_supported",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "UnsupportedConcurrencyV2",
      "type": "object"
    },
    "UnsupportedIdempotencyV2": {
      "additionalProperties": false,
      "description": "Declare that the source exposes no usable idempotency strategy.",
      "properties": {
        "mode": {
          "enum": [
            "unsupported",
            "runtime_deduplicate"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "UnsupportedIdempotencyV2",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An evidence-backed request and response contract for one Operation.",
  "properties": {
    "action_semantics": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionSemantics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/SchemaProvenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "request_completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "Request Completeness",
      "type": "string"
    },
    "request_schema": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Request Schema",
      "type": "object"
    },
    "response_completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "Response Completeness",
      "type": "string"
    },
    "response_schema": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Response Schema",
      "type": "object"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "operation_id",
    "request_schema",
    "response_schema",
    "request_completeness",
    "response_completeness",
    "provenance"
  ],
  "title": "SourceContract",
  "type": "object"
}
