          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Pointer"
        }
      },
      "required": [
        "mode"
      ],
      "title": "OptionSearch",
      "type": "object"
    },
