        "mode": {
          "enum": [
            "none",
            "offset",
            "cursor",
            "page"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Pointer"
        },
        "response_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Pointer"
        }
      },
      "required": [
        "mode"
      ],
      "title": "OptionPagination",
      "type": "object"
    },
    "OptionSearch": {
