{
  "$defs": {
    "AllExpression": {
      "additionalProperties": false,
      "description": "Require every nested safe expression to hold.",
      "properties": {
        "operands": {
          "items": {
            "$ref": "#/$defs/ConditionExpression"
          },
          "minItems": 1,
          "title": "Operands",
          "type": "array"
        },
        "operator": {
          "const": "all",
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "operands"
      ],
      "title": "AllExpression",
      "type": "object"
    },
    "AnyExpression": {
      "additionalProperties": false,
      "description": "Require at least one nested safe expression to hold.",
      "properties": {
        "operands": {
          "items": {
            "$ref": "#/$defs/ConditionExpression"
          },
          "minItems": 1,
          "title": "Operands",
          "type": "array"
        },
        "operator": {
          "const": "any",
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "operands"
      ],
      "title": "AnyExpression",
      "type": "object"
    },
    "ComparisonExpression": {
      "additionalProperties": false,
      "description": "Compare two safe operands without executing source code.",
      "properties": {
        "left": {
          "$ref": "#/$defs/ConditionOperand"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "in"
          ],
          "title": "Operator",
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/ConditionOperand"
        }
      },
      "required": [
        "operator",
        "left",
        "right"
      ],
      "title": "ComparisonExpression",
      "type": "object"
    },
    "ConditionExpression": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllExpression",
          "any": "#/$defs/AnyExpression",
          "eq": "#/$defs/ComparisonExpression",
          "in": "#/$defs/ComparisonExpression",
          "ne": "#/$defs/ComparisonExpression",
          "not": "#/$defs/NotExpression",
          "present": "#/$defs/PresentExpression"
        },
        "propertyName": "operator"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AllExpression"
        },
        {
          "$ref": "#/$defs/AnyExpression"
        },
        {
          "$ref": "#/$defs/NotExpression"
        },
        {
          "$ref": "#/$defs/ComparisonExpression"
        },
        {
          "$ref": "#/$defs/PresentExpression"
        }
      ]
    },
    "ConditionOperand": {
      "discriminator": {
        "mapping": {
          "literal": "#/$defs/LiteralOperand",
          "reference": "#/$defs/ReferenceOperand"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReferenceOperand"
        },
        {
          "$ref": "#/$defs/LiteralOperand"
        }
      ]
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A digest-bound locator supporting current evidence forms.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "source_file",
                "json_document",
                "openapi",
                "openapi_operation",
                "content",
                "content_summary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "openapi_operation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openapi Operation"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "source_id",
        "digest"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "InputBinding": {
      "additionalProperties": false,
      "description": "Map one consumer input to an evidenced client-side source.",
      "properties": {
        "cardinality": {
          "enum": [
            "one",
            "optional",
            "many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "literal_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputMapping"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_kind": {
          "enum": [
            "user_input",
            "route_parameter",
            "selected_record",
            "prior_response",
            "trusted_context",
            "literal",
            "computed",
            "user_preference"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Pointer"
        },
        "target_pointer": {
          "title": "Target Pointer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_kind",
        "target_pointer",
        "cardinality",
        "evidence"
      ],
      "title": "InputBinding",
      "type": "object"
    },
    "InputMapping": {
      "additionalProperties": false,
      "description": "A bounded declarative value mapping recorded by discovery.",
      "properties": {
        "kind": {
          "enum": [
            "identity",
            "date",
            "datetime",
            "enum",
            "identifier",
            "locale",
            "null",
            "number",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mapping": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Mapping",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "InputMapping",
      "type": "object"
    },
    "InteractionCondition": {
      "additionalProperties": false,
      "description": "Apply a bounded, platform-neutral condition to one semantic target.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "expression": {
          "$ref": "#/$defs/ConditionExpression"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target": {
          "enum": [
            "visible",
            "enabled",
            "required",
            "reset"
          ],
          "title": "Target",
          "type": "string"
        },
        "target_pointer": {
          "title": "Target Pointer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "target_pointer",
        "expression",
        "evidence"
      ],
      "title": "InteractionCondition",
      "type": "object"
    },
    "InteractionDefault": {
      "additionalProperties": false,
      "description": "An evidenced default including authority, precedence, and submission behavior.",
      "properties": {
        "authority": {
          "enum": [
            "contract",
            "implementation",
            "test",
            "observation"
          ],
          "title": "Authority",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "override_policy": {
          "enum": [
            "caller_allowed",
            "runtime_only",
            "forbidden"
          ],
          "title": "Override Policy",
          "type": "string"
        },
        "precedence": {
          "enum": [
            "caller_over_default",
            "default_over_caller",
            "source_default"
          ],
          "title": "Precedence",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "literal",
            "source_response",
            "trusted_context",
            "user_preference",
            "computed"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "submission": {
          "enum": [
            "omit",
            "send",
            "send_if_changed"
          ],
          "title": "Submission",
          "type": "string"
        },
        "target_pointer": {
          "title": "Target Pointer",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "target_pointer",
        "source_kind",
        "authority",
        "precedence",
        "submission",
        "override_policy",
        "evidence"
      ],
      "title": "InteractionDefault",
      "type": "object"
    },
    "InteractionOmission": {
      "additionalProperties": false,
      "description": "Document an evidence-backed decision not to adopt one source interaction.",
      "properties": {
        "authority": {
          "enum": [
            "contract",
            "implementation",
            "test"
          ],
          "title": "Authority",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "interaction_id": {
          "minLength": 1,
          "title": "Interaction Id",
          "type": "string"
        },
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "justification",
        "authority",
        "evidence"
      ],
      "title": "InteractionOmission",
      "type": "object"
    },
    "InteractionOverride": {
      "additionalProperties": false,
      "description": "Document an evidence-backed deviation from one adopted source interaction.",
      "properties": {
        "authority": {
          "enum": [
            "contract",
            "implementation",
            "test"
          ],
          "title": "Authority",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interaction_id": {
          "minLength": 1,
          "title": "Interaction Id",
          "type": "string"
        },
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "target_pointer": {
          "title": "Target Pointer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "interaction_id",
        "target_pointer",
        "justification",
        "authority",
        "evidence"
      ],
      "title": "InteractionOverride",
      "type": "object"
    },
    "JsonValue": {},
    "LiteralOperand": {
      "additionalProperties": false,
      "description": "Use one inert JSON-compatible literal in a condition.",
      "properties": {
        "kind": {
          "const": "literal",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LiteralOperand",
      "type": "object"
    },
    "NotExpression": {
      "additionalProperties": false,
      "description": "Negate one nested safe expression.",
      "properties": {
        "operand": {
          "$ref": "#/$defs/ConditionExpression"
        },
        "operator": {
          "const": "not",
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "operand"
      ],
      "title": "NotExpression",
      "type": "object"
    },
    "OptionCache": {
      "additionalProperties": false,
      "description": "Cache policy without assuming a client framework or storage implementation.",
      "properties": {
        "max_age_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Age Seconds"
        },
        "mode": {
          "enum": [
            "none",
            "interaction",
            "session"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "OptionCache",
      "type": "object"
    },
    "OptionPagination": {
