{
  "$defs": {
    "CandidateDisposition": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "accepted",
            "deferred",
            "rejected",
            "blocked"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "materialized_capability_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Materialized Capability Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "disposition",
        "materialized_capability_ids",
        "rationale"
      ],
      "title": "CandidateDisposition",
      "type": "object"
    },
    "DependencyDecisionRef": {
      "additionalProperties": false,
      "properties": {
        "decision_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decision Digest",
          "type": "string"
        },
        "domain_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Domain Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "domain_id",
        "revision",
        "decision_digest"
      ],
      "title": "DependencyDecisionRef",
      "type": "object"
    },
    "DomainPolicy": {
      "additionalProperties": false,
      "description": "Business choices only; source permissions are intentionally not representable.",
      "properties": {
        "allowed_effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "minItems": 1,
          "title": "Allowed Effects",
          "type": "array"
        },
        "approval_required_for": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Approval Required For",
          "type": "array"
        },
        "excluded_intents": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Excluded Intents",
          "type": "array"
        },
        "goals": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Goals",
          "type": "array"
        },
        "maximum_risk": {
          "$ref": "#/$defs/Risk"
        }
      },
      "required": [
        "goals",
        "allowed_effects",
        "maximum_risk",
        "approval_required_for",
        "excluded_intents"
      ],
      "title": "DomainPolicy",
      "type": "object"
    },
    "Effect": {
      "enum": [
        "read",
        "create",
        "update",
        "delete",
        "transition",
        "execute"
      ],
      "type": "string"
    },
    "EvidenceSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        }
      },
      "required": [
        "evidence_ref",
        "digest"
      ],
      "title": "EvidenceSnapshotRef",
      "type": "object"
    },
    "Risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "UserConfirmation": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "authenticated_user",
            "delegated_reviewer"
          ],
          "title": "Authority",
          "type": "string"
        },
        "confirmation_summary": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Confirmation Summary",
          "type": "string"
        },
        "confirmed_at": {
          "maxLength": 40,
          "minLength": 20,
          "title": "Confirmed At",
          "type": "string"
        },
        "confirmed_decision_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Confirmed Decision Digest",
          "type": "string"
        },
        "confirmer_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Confirmer Ref",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/UserDecision"
          },
          "minItems": 1,
          "title": "Decisions",
          "type": "array"
        },
        "source_evidence_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Evidence Ref",
          "type": "string"
        },
        "source_text_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Text Digest",
          "type": "string"
        }
      },
      "required": [
        "confirmer_ref",
        "authority",
        "confirmation_summary",
        "source_evidence_ref",
        "source_text_digest",
        "confirmed_at",
        "confirmed_decision_digest",
        "decisions"
      ],
      "title": "UserConfirmation",
      "type": "object"
    },
    "UserDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "confirmed",
            "accepted",
            "deferred",
            "rejected",
            "blocked",
            "approved"
          ],
          "title": "Decision",
          "type": "string"
        },
        "kind": {
          "enum": [
            "domain_policy",
            "candidate_disposition",
            "domain_completion",
            "change_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "subject_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject_ref",
        "decision",
        "rationale"
      ],
      "title": "UserDecision",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_dispositions": {
      "items": {
        "$ref": "#/$defs/CandidateDisposition"
      },
      "title": "Candidate Dispositions",
      "type": "array"
    },
    "candidate_ledger_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Ledger Digest",
      "type": "string"
    },
    "candidate_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Snapshot Digest",
      "type": "string"
    },
    "candidate_snapshot_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Candidate Snapshot Ids",
      "type": "array"
    },
    "dependency_decisions": {
      "items": {
        "$ref": "#/$defs/DependencyDecisionRef"
      },
      "title": "Dependency Decisions",
      "type": "array"
    },
    "dependency_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dependency Snapshot Digest",
      "type": "string"
    },
    "domain_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Domain Id",
      "type": "string"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Digest",
      "type": "string"
    },
    "evidence_snapshot": {
      "items": {
        "$ref": "#/$defs/EvidenceSnapshotRef"
      },
      "title": "Evidence Snapshot",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/DomainPolicy"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready_for_review",
        "completed",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "unresolved_questions": {
      "items": {
        "maxLength": 16384,
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "user_confirmation": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserConfirmation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "domain_id",
    "revision",
    "status",
    "policy",
    "candidate_dispositions",
    "candidate_snapshot_ids",
    "candidate_snapshot_digest",
    "candidate_ledger_digest",
    "unresolved_questions",
    "dependency_decisions",
    "evidence_snapshot",
    "dependency_snapshot_digest",
    "evidence_digest",
    "user_confirmation"
  ],
  "title": "DomainDecision",
  "type": "object"
}
